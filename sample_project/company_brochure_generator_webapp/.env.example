# ---------------------------------------------------------------------------
# Company Brochure Generator — environment variable placeholders
# ---------------------------------------------------------------------------
# This app requires NO external API keys or secrets.
# All inference is performed locally via Ollama (http://localhost:11434).
#
# This file is provided as a template in case you extend the app to use
# additional services in the future.
#
# HOW TO USE (if you add secrets later):
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your values in .env
#   3. Load them in Python with:  pip install python-dotenv
#      then add to your script:   from dotenv import load_dotenv; load_dotenv()
#
# NEVER commit your real .env file to version control.
# ---------------------------------------------------------------------------

# Ollama server base URL (change only if you run Ollama on a remote host)
# OLLAMA_BASE_URL=http://localhost:11434

# Default model tag (overridden at runtime by the Streamlit sidebar)
# OLLAMA_DEFAULT_MODEL=llama3.1:8b
